{
  "name": "violation.api",
  "version": "1.1.0",
  "description": "violation",
  "main": "server.js",
  "config": {
    "port": 5001,
    "domain": "api.violation"
  },
  "scripts": {
    "fetch": "git pull && npm install",
    "dev": "nodemon -x babel-node src/server.js --trace-warnings",
    "build": "rimraf dist/ && babel ./src --out-dir dist/ --ignore node_modules",
    "stop": "pm2 stop dist/server.js",
    "start": "npm run build && pm2 start dist/server.js -i max",
    "xaxa": "npm run build && pm2 start dist/server.js --node-args=\"--max-old-space-size=12144\" --name \"$npm_package_config_port $npm_package_config_domain\"",
    "restart": "npm run stop && npm run start",
    "publish": "npm run fetch && npm run build && pm2 restart dist/server.js"
  },
  "author": "mD",
  "license": "ISC",
  "dependencies": {
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-transform-object-rest-spread": "^7.24.5",
    "agenda": "^5.0.0",
    "axios": "^1.4.0",
    "body-parser": "^1.20.2",
    "bunyan": "^1.8.15",
    "cors": "^2.8.5",
    "crypto-js": "^4.1.1",
    "date-fns": "^2.30.0",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-basic-auth": "^1.2.1",
    "express-jwt": "^8.4.1",
    "express-validator": "^7.0.1",
    "fs": "^0.0.1-security",
    "helmet": "^6.1.5",
    "http": "^0.0.1-security",
    "https": "^1.0.0",
    "is-empty": "^1.2.0",
    "loadtest": "^8.0.9",
    "mkdirp": "^3.0.1",
    "moment": "^2.29.4",
    "mongoose": "^7.0.4",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^4.0.2",
    "object-path": "^0.11.8",
    "path": "^0.12.7",
    "pdfkit": "^0.13.0",
    "process": "^0.11.10",
    "socket.io": "^4.7.2",
    "utf8": "^3.0.0",
    "uuid": "^9.0.0",
    "ws": "^8.13.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.21.0",
    "@babel/core": "^7.21.4",
    "@babel/node": "^7.20.7",
    "@babel/preset-env": "^7.21.4",
    "dotenv": "^16.0.3",
    "nodemon": "^2.0.22",
    "pm2": "^5.3.0",
    "rimraf": "^5.0.0"
  }
}
