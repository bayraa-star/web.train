{
  "name": "web-front",
  "version": "1.0.1",
  "private": true,
  "config": {
    "port": 3305,
    "domain": "web violation"
  },
  "scripts": {
    "dev": "PORT=$npm_package_config_port react-scripts start",
    "build": "react-scripts build",
    "eject": "react-scripts eject",
    "fetch": "git pull && npm install",
    "start": "npm run build && pm2 start server.js --name \"$npm_package_config_port $npm_package_config_domain\"",
    "stop": "pm2 stop server.js",
    "restart": "npm stop && npm start",
    "publish": "npm run fetch && npm run build"
  },
  "dependencies": {
    "antd": "^5.15.2",
    "axios": "^1.3.3",
    "axios-auth-refresh": "^3.3.6",
    "crypto-js": "^4.1.1",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.0.0",
    "date-fns": "^2.29.3",
    "flickity": "^2.3.0",
    "formik": "^2.2.9",
    "html2canvas": "^1.4.1",
    "i18next": "^22.4.9",
    "i18next-browser-languagedetector": "^7.0.1",
    "i18next-http-backend": "^2.1.1",
    "iconsax-react": "^0.0.8",
    "js-cookie": "^3.0.1",
    "leaflet": "^1.9.4",
    "moment": "^2.29.4",
    "object-path": "^0.11.8",
    "react": "^18.2.0",
    "react-alice-carousel": "^2.8.0",
    "react-collapsible": "^2.10.0",
    "react-countdown-simple": "^1.0.12",
    "react-datepicker": "^6.6.0",
    "react-datetime": "^3.2.0",
    "react-day-picker": "^8.6.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-i18next": "^12.1.5",
    "react-icons": "^4.7.1",
    "react-image-gallery": "^1.3.0",
    "react-leaflet": "^4.2.1",
    "react-map-interaction": "^2.1.0",
    "react-paginate": "^8.1.4",
    "react-router-dom": "^6.8.1",
    "react-scripts": "5.0.1",
    "react-select": "^5.7.0",
    "react-slick": "^0.29.0",
    "react-tabs": "^6.0.2",
    "react-toggle": "^4.1.3",
    "recharts": "^2.5.0",
    "sweetalert2": "^11.22.0",
    "sweetalert2-react-content": "^5.0.7",
    "xlsx": "^0.18.5",
    "yup": "^1.0.2"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "express": "^4.18.2",
    "pm2": "^5.2.2",
    "tailwindcss": "^3.2.6"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
